{
  "name": "sydes-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Foundation for a Sydes graph-aware policy extension on the Pi harness.",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "smoke:cbm": "vite-node scripts/smoke-cbm.ts",
    "smoke:cbm-latency": "vite-node scripts/smoke-cbm-latency.ts",
    "smoke:cbm-readiness": "vite-node scripts/smoke-cbm-readiness.ts",
    "smoke:impact": "vite-node scripts/smoke-impact.ts",
    "smoke:policy": "vite-node scripts/smoke-policy.ts",
    "smoke:worktree-policy": "vite-node scripts/smoke-worktree-policy.ts",
    "smoke:drift-replay": "vite-node scripts/smoke-drift-replay.ts",
    "smoke:pi": "vite-node scripts/smoke-pi.ts",
    "live:sydes": "vite-node scripts/run-live-sydes.ts",
    "analyze:latest": "vite-node scripts/analyze-latest.ts",
    "bench": "SYDES_BENCH_ENTRY=1 vite-node scripts/bench.ts",
    "bench:pair": "vite-node scripts/bench-pair.ts",
    "bench:report": "vite-node scripts/bench-report.ts",
    "swe:import": "vite-node scripts/swe-import.ts",
    "swe:bench": "vite-node scripts/swe-bench.ts",
    "swe:pair": "vite-node scripts/swe-pair.ts",
    "swe:repeat": "vite-node scripts/swe-repeat.ts",
    "swe:analyze": "vite-node scripts/swe-analyze.ts",
    "swe:predictions": "vite-node scripts/swe-predictions.ts",
    "swe:grade": "vite-node scripts/swe-grade.ts",
    "swe:parse-report": "vite-node scripts/swe-parse-report.ts",
    "swe:report": "vite-node scripts/swe-report.ts",
    "swe:candidates": "vite-node scripts/swe-candidates.ts"
  },
  "keywords": [
    "sydes",
    "pi",
    "codebase-memory"
  ],
  "license": "UNLICENSED",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "codebase-memory-mcp": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
